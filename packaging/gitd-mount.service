[Unit]
Description=gitd-mount, which mounts gitd's overlay workspaces so gitd needs no privilege
Requires=gitd-mount.socket
After=gitd-mount.socket
Before=gitd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/gitd-mount --config /etc/gitd/gitd-mount.conf
# Root, holding the capabilities mounting an overlay takes, and nothing else.
User=root
# CAP_SYS_ADMIN mounts. The kernel then writes each overlay's upper and work directories,
# which are gitd's, with the credentials of whoever mounted it: without CAP_DAC_OVERRIDE,
# CAP_FOWNER and CAP_CHOWN the overlay comes up read-only, or cannot copy a file up keeping
# its owner. Nothing else.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
AmbientCapabilities=
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# No ProtectSystem, PrivateTmp, ProtectHome or ReadWritePaths: each gives the service a
# mount namespace of its own, and the overlays it mounts would never be seen outside it.
Restart=on-failure
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gitd-mount
